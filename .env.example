# CampusConnect Environment Configuration

# GEMINI_API_KEY: Required for Gemini AI server-side API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: AI model for issue triage, clarity inspection, and classification (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# DATABASE_URL: Neon PostgreSQL connection URI with SSL mode enabled.
# e.g., postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# SESSION_SECRET: High-entropy secret for HMAC SHA-256 signed session tokens (7-day expiry)
SESSION_SECRET="generate-a-secure-random-32-byte-hex-secret-here"

# BLOB_READ_WRITE_TOKEN: Optional Vercel Blob token for cloud photo uploads
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# FOUNDER_REGISTRATION_KEY: Optional secret key to initialize global founder account
FOUNDER_REGISTRATION_KEY="founder-init-master-2026"

# APP_URL: Base domain where the app is deployed
APP_URL="https://campusconnect.com"
